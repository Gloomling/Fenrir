# =============================================================================
# Fenrir Security Scanner — .gitignore
# =============================================================================

# ── Secrets / credentials ─────────────────────────────────────────────────────
.env
*.env
.env.local
.env.*.local

# ── Scan output ───────────────────────────────────────────────────────────────
Results/
scan_history.db
scan_history.db-shm
scan_history.db-wal

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
fenrir.log

# ── Offline intelligence database (built at runtime, can be large) ────────────
# The .db files themselves
fenrir/database/fenrir.db
fenrir/database/fenrir.db-shm
fenrir/database/fenrir.db-wal

# The entire exploits/ and shellcodes/ folder trees (downloaded at runtime)
fenrir/database/exploits/
fenrir/database/exploits/**
fenrir/database/shellcodes/
fenrir/database/shellcodes/**

# Any other database folder that might be created at runtime
data/
data/**

# ── Runtime databases (anywhere in the project) ───────────────────────────────
*.db
*.db-shm
*.db-wal
scan_history.db

# ── Keys ──────────────────────────────────────────────────────────────────────
fenrir_keys.json

# ── Branding (operator-managed, not committed) ────────────────────────────────
branding.json
assets/logo.png
assets/background.png
assets/icon.ico
assets/icon.png

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.fenrir/
~/.fenrir/

# ── Build / packaging ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
.mypy_cache/
.ruff_cache/
data/
data/
